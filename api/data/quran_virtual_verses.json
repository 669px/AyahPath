{
  "verses": [
    {
      "category": "stress",
      "verse": {
        "id": 1762,
        "chapter_id": 13,
        "verse_number": 28,
        "verse_key": "13:28",
        "text_uthmani": "ٱلَّذِينَ ءَامَنُوا۟ وَتَطْمَئِنُّ قُلُوبُهُم بِذِكْرِ ٱللَّهِ ۗ أَلَا بِذِكْرِ ٱللَّهِ تَطْمَئِنُّ ٱلْقُلُوبُ",
        "juz_number": 13,
        "hizb_number": 26,
        "page_number": 252,
        "words": [],
        "audio": {
          "verse_key": "13:28",
          "url": "https://verses.quran.com/Abdul_Basit/mp3/013028.mp3"
        },
        "translations": [
          {
            "resource_id": 131,
            "text": "those who believe and whose hearts find comfort in the remembrance of Allah. Surely in the remembrance of Allah do hearts find comfort.",
            "verse_key": "13:28"
          }
        ]
      }
    },
    {
      "category": "stress",
      "verse": {
        "id": 286,
        "chapter_id": 2,
        "verse_number": 286,
        "verse_key": "2:286",
        "text_uthmani": "لَا يُكَلِّفُ ٱللَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا ٱكْتَسَبَتْ",
        "juz_number": 3,
        "hizb_number": 6,
        "page_number": 49,
        "words": [],
        "audio": {
          "verse_key": "2:286",
          "url": "https://verses.quran.com/Abdul_Basit/mp3/002286.mp3"
        },
        "translations": [
          {
            "resource_id": 131,
            "text": "Allah does not require of any soul more than what it can afford. All good will be for its own benefit, and all evil will be to its own loss.",
            "verse_key": "2:286"
          }
        ]
      }
    },
    {
      "category": "stress",
      "verse": {
        "id": 6200,
        "chapter_id": 94,
        "verse_number": 5,
        "verse_key": "94:5",
