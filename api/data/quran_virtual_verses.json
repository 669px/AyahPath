      }
    },
    {
      "category": "jealousy",
      "verse": {
        "id": 588,
        "chapter_id": 4,
        "verse_number": 54,
        "verse_key": "4:54",
        "text_uthmani": "أَمْ يَحْسُدُونَ ٱلنَّاسَ عَلَىٰ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦ",
