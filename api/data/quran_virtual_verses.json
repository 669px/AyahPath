        "hizb_number": 48,
        "page_number": 480,
        "words": [],
        "audio": {
          "verse_key": "41:34",
          "url": "https://verses.quran.com/Abdul_Basit/mp3/041034.mp3"
        },
        "translations": [
          {
            "resource_id": 131,
            "text": "Good and evil cannot be equal. Repel evil with what is better.",
            "verse_key": "41:34"
          }
        ]
      }
    },
    {
      "category": "anger",
      "verse": {
        "id": 4637,
        "chapter_id": 42,
        "verse_number": 37,
        "verse_key": "42:37",
