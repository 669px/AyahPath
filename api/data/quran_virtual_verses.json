        },
        "translations": [
          {
            "resource_id": 131,
            "text": "So, surely with hardship comes ease.",
            "verse_key": "94:5"
          }
        ]
      }
    },
    {
      "category": "anger",
      "verse": {
        "id": 401,
        "chapter_id": 3,
        "verse_number": 134,
        "verse_key": "3:134",
        "text_uthmani": "ٱلَّذِينَ يُنفِقُونَ فِى ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلْكَـٰظِمِينَ ٱلْغَيْظَ وَٱلْعَافِينَ عَنِ ٱلنَّاسِ ۗ وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ",
        "juz_number": 4,
        "hizb_number": 7,
        "page_number": 67,
        "words": [],
        "audio": {
          "verse_key": "3:134",
          "url": "https://verses.quran.com/Abdul_Basit/mp3/003134.mp3"
        },
        "translations": [
          {
            "resource_id": 131,
            "text": "They are those who donate in prosperity and adversity, control their anger, and pardon others. And Allah loves the good-doers.",
            "verse_key": "3:134"
          }
        ]
      }
    },
    {
      "category": "anger",
      "verse": {
        "id": 4534,
        "chapter_id": 41,
        "verse_number": 34,
        "verse_key": "41:34",
        "text_uthmani": "وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُ ۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ",
