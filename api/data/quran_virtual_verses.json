    {
      "category": "gratitude",
      "verse": {
        "id": 1833,
        "chapter_id": 14,
        "verse_number": 7,
        "verse_key": "14:7",
        "text_uthmani": "وَإِذْ تَأَذَّنَ رَبُّكُمْ لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ",
