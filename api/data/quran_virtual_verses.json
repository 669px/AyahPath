        "words": [],
        "audio": {
          "verse_key": "4:54",
          "url": "https://verses.quran.com/Abdul_Basit/mp3/004054.mp3"
        },
        "translations": [
          {
            "resource_id": 131,
            "text": "Or do they envy others for what Allah has given them of His bounty?",
            "verse_key": "4:54"
